{
  "name": "Core Banking Microservices (2 vCPU / 8GB RAM)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installMaven": "true"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [
    5173,
    8080,
    8090,
    15672
  ],
  "portsAttributes": {
    "5173": {
      "label": "Teller Web Portal (React Vite)",
      "onAutoForward": "openPreview",
      "visibility": "public"
    },
    "8080": {
      "label": "API Gateway (Spring Cloud Gateway)",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "8090": {
      "label": "Kafka UI Dashboard",
      "onAutoForward": "silent"
    },
    "15672": {
      "label": "RabbitMQ Management UI",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "mvn -f backend/pom.xml clean package -DskipTests && cd frontend/cash-deposit-portal && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "ms-azuretools.vscode-docker",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
