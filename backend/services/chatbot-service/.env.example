# --- LLM Client (OpenAI SDK Standard) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Primary Gemini Key
LLM_API_KEY=your_primary_gemini_api_key_here
# Backup Gemini Key (Tự động failover khi Key 1 hết hạn ngạch)
LLM_BACKUP_API_KEY=your_backup_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash

# --- PostgreSQL with pgvector ---
DATABASE_URL=postgresql://chatbot_db_user:ChatbotDb#Secure2025!@postgres-chatbot:5432/ewallet_chatbot_db

# --- Embedding Model & Data ---
EMBED_MODEL=intfloat/multilingual-e5-small
DATA_DIR=./data
TOP_K=4
MAX_DISTANCE=0.38

# --- Bảo Mật Nội Bộ Microservices ---
INTERNAL_API_KEY=senhong-internal-chatbot-key-2026
