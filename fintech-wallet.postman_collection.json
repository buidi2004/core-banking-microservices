{
	"info": {
		"_postman_id": "9d25d0de-fintech-wallet-v1",
		"name": "Fintech E-Wallet API Collection (Production Ready)",
		"description": "Comprehensive Postman collection for Fintech E-Wallet (Hexagonal Architecture + DDD)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication & Security",
			"item": [
				{
					"name": "Register Account",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"0988111222\",\n  \"password\": \"SecurePassword123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "register"] }
					}
				},
				{
					"name": "Login Account",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"phoneNumber\": \"0988111222\",\n  \"password\": \"SecurePassword123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "login"] }
					}
				},
				{
					"name": "Logout (Token Revocation)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "v1", "auth", "logout"] }
					}
				}
			]
		},
		{
			"name": "2. Wallet & Transfer",
			"item": [
				{
					"name": "Task 9: Verify Recipient Info (Masked Name)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/wallets/recipient-info?phoneNumber=0977333444",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "wallets", "recipient-info"],
							"query": [{ "key": "phoneNumber", "value": "0977333444" }]
						}
					}
				},
				{
					"name": "Deposit Money",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"amount\": 500000,\n  \"currency\": \"VND\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/wallets/deposit", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "deposit"] }
					}
				},
				{
					"name": "Init Transfer",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"sourceWalletId\": \"{{walletId}}\",\n  \"targetWalletId\": \"{{targetWalletId}}\",\n  \"amount\": 100000,\n  \"currency\": \"VND\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/wallets/transfer/init", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "transfer", "init"] }
					}
				},
				{
					"name": "Confirm Transfer (PIN/OTP)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" },
							{ "key": "Idempotency-Key", "value": "{{$guid}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"transactionId\": \"{{transactionId}}\",\n  \"pin\": \"123456\",\n  \"otp\": \"123456\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/wallets/transfer/confirm", "host": ["{{baseUrl}}"], "path": ["api", "v1", "wallets", "transfer", "confirm"] }
					}
				}
			]
		},
		{
			"name": "3. VietQR & Transactions",
			"item": [
				{
					"name": "Get My VietQR Code",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/users/me/qrcode", "host": ["{{baseUrl}}"], "path": ["api", "v1", "users", "me", "qrcode"] }
					}
				},
				{
					"name": "Get Transaction History (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/transactions?walletId={{walletId}}&page=0&size=20",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "transactions"],
							"query": [
								{ "key": "walletId", "value": "{{walletId}}" },
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "20" }
							]
						}
					}
				}
			]
		},
		{
			"name": "4. Actuator & Monitoring",
			"item": [
				{
					"name": "Actuator Health Check",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/actuator/health", "host": ["{{baseUrl}}"], "path": ["actuator", "health"] }
					}
				},
				{
					"name": "Actuator Prometheus Metrics",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/actuator/prometheus", "host": ["{{baseUrl}}"], "path": ["actuator", "prometheus"] }
					}
				},
				{
					"name": "OpenAPI / Swagger JSON",
					"request": {
						"method": "GET",
						"url": { "raw": "{{baseUrl}}/v3/api-docs", "host": ["{{baseUrl}}"], "path": ["v3", "api-docs"] }
					}
				}
			]
		},
		{
			"name": "5. Receipt & Funding Sources",
			"item": [
				{
					"name": "Download PDF Receipt",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/transactions/{{transactionId}}/receipt.pdf", "host": ["{{baseUrl}}"], "path": ["api", "v1", "transactions", "{{transactionId}}", "receipt.pdf"] }
					}
				},
				{
					"name": "Get Funding Sources",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/funding-sources", "host": ["{{baseUrl}}"], "path": ["api", "v1", "funding-sources"] }
					}
				},
				{
					"name": "Link Funding Source",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"type\": \"CREDIT_CARD\",\n  \"provider\": \"VISA\",\n  \"number\": \"4970123456789012\",\n  \"cardHolderName\": \"NGUYEN VAN A\",\n  \"expiryDate\": \"12/26\",\n  \"cvv\": \"123\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/funding-sources/link", "host": ["{{baseUrl}}"], "path": ["api", "v1", "funding-sources", "link"] }
					}
				},
				{
					"name": "Unlink Funding Source",
					"request": {
						"method": "DELETE",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": { "raw": "{{baseUrl}}/api/v1/funding-sources/{{fundingSourceId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "funding-sources", "{{fundingSourceId}}"] }
					}
				}
			]
		},
		{
			"name": "6. Bill Payment",
			"item": [
				{
					"name": "Lookup Bill",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/bills/lookup?type=ELECTRICITY&customerCode=PE123456",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "bills", "lookup"],
							"query": [
								{ "key": "type", "value": "ELECTRICITY" },
								{ "key": "customerCode", "value": "PE123456" }
							]
						}
					}
				},
				{
					"name": "Pay Bill",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"billId\": \"{{billId}}\",\n  \"amount\": 150000,\n  \"currency\": \"VND\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/bills/pay", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills", "pay"] }
					}
				},
				{
					"name": "Topup Phone",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"requestId\": \"{{$guid}}\",\n  \"walletId\": \"{{walletId}}\",\n  \"phoneNumber\": \"0988111222\",\n  \"amount\": 50000,\n  \"currency\": \"VND\"\n}"
						},
						"url": { "raw": "{{baseUrl}}/api/v1/bills/topup", "host": ["{{baseUrl}}"], "path": ["api", "v1", "bills", "topup"] }
					}
				}
			]
		}
	],
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:8080" },
		{ "key": "token", "value": "" },
		{ "key": "walletId", "value": "" },
		{ "key": "targetWalletId", "value": "" },
		{ "key": "transactionId", "value": "" },
		{ "key": "fundingSourceId", "value": "" },
		{ "key": "billId", "value": "" }
	]
}
