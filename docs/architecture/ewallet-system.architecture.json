  "cards": [
    {
      "dot": "emerald",
      "title": "Kiến trúc 6 DBs (Database-per-Service)",
      "items": [
        "Phân rã 6 cơ sở dữ liệu Postgres độc lập (:5433-:5438), cô lập hoàn toàn schema và user roles",
        "Sổ cái General Ledger áp dụng phân quyền Append-Only chống sửa/xóa bút toán tài chính (Delta = 0)"
      ]
    },
    {
      "dot": "cyan",
      "title": "Dual-Broker & Saga Orchestration",
      "items": [
        "Payment Engine gọi gRPC Wallet Internal để Lock/Debit/Credit số dư với độ trễ thấp (<15ms)",
        "Kafka KRaft 6 partitions đồng bộ sổ cái kết hợp RabbitMQ điều phối hàng đợi tác vụ bất đồng bộ"
      ]
    },
    {
      "dot": "violet",
      "title": "AI & Biometrics GPU Tăng Tốc",
      "items": [
        "eKYC AI Microservice (:8900) chạy GPU NVIDIA GTX 1650 CUDA: SCRFD phát hiện mặt & ArcFace 512-d",
        "Trợ lý Chatbot AI (:8000) RAG Hybrid Search (pgvector + tsvector Reciprocal Rank Fusion) và JEV Gate"
      ]
    },
    {
      "dot": "amber",
      "title": "Bảo mật Ngân hàng Đa lớp & Chống Gian lận",
      "items": [
        "API Gateway lọc JWT, khóa token qua Redis Blacklist và giới hạn tần suất request (Rate Limiting)",
        "Xác thực mã PIN bằng BCrypt độ mạnh 12, cơ chế chống tấn công bom giải nén ảnh eKYC trực tiếp trên RAM"
      ]
    }
  ]
