      },
      {
        "id": "flow-ekyc-ai",
        "label": "Luồng 2: Xác thực eKYC Biometric AI",
        "focus": ["client_mobile", "api_gateway", "svc_identity", "svc_ekyc_ai", "redis_cluster", "postgres_dbs"],
        "note": "Mobile truyền ảnh nhận diện mặt thật; Gateway chuyển tới eKYC AI Service chạy GPU CUDA so khớp ArcFace 512-d và MiniFASNetV2."
      },
      {
        "id": "flow-cash-deposit",
        "label": "Luồng 3: Nạp tiền Quầy Maker-Checker",
        "focus": ["client_web", "api_gateway", "svc_payment", "svc_ledger", "kafka_stream", "postgres_dbs"],
        "note": "Giao dịch viên tạo yêu cầu nạp tiền, Kiểm soát viên phê duyệt 2 cấp; bút toán định khoản kép bất biến vào Sổ cái General Ledger."
      },
      {
        "id": "flow-event-streaming",
        "label": "Luồng 4: Event Streaming & Bắn thông báo",
        "focus": ["kafka_stream", "svc_ledger", "svc_notification", "fcm_cloud", "client_mobile", "postgres_dbs"],
        "note": "Ledger ghi bút toán nợ/có tự động, Notification Service tiêu thụ stream giao dịch để bắn FCM Push Alert và WebSocket STOMP."
      }
