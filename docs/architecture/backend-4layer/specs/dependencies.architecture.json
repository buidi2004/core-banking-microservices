  "cards": [
    {
      "dot": "cyan",
      "title": "Đồng bộ",
      "items": [
        "Client → Gateway :8080 (JWT filter, Redis blacklist, rate limit)",
        "Payment → Wallet gRPC :9090 (Reserve / Debit / Credit / Release / CheckLimit)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Bất đồng bộ",
      "items": [
        "Identity → RabbitMQ user.registered → Wallet auto-create ví",
        "Payment Outbox Relay → RabbitMQ transaction.* + Kafka lifecycle",
        "Wallet → Kafka balance-changed",
        "Ledger + Notification consume cả RabbitMQ và Kafka (at-least-once, idempotent)"
      ]
    },
    {
      "dot": "amber",
      "title": "Lưu trữ & hạ tầng",
      "items": [
        "5 PostgreSQL độc lập :5433–:5437, Flyway mỗi service",
        "Redis: JWT blacklist, OTP TTL, distributed lock",
        "Firebase FCM cho push, STOMP /topic/notifications cho WebSocket"
      ]
    },
    {
      "dot": "slate",
      "title": "Hợp đồng dữ liệu",
      "items": [
        "common-library: wallet.proto (gRPC stubs), KafkaEventEnvelope, topic constants, BaseKafkaProducer",
        "Mọi event mang eventId → consumer chống trùng (idempotency)"
      ]
    }
  ]
